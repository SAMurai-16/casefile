# ==============================================================================
# CaseFile Environment Configuration
# Copy this file to .env and insert your API keys:
#   cp .env.example .env
# ==============================================================================

# LLM Provider Configuration
# Supported providers: "gemini", "openai", "mock"
LLM_PROVIDER=gemini

# Model Selection
# Gemini: "gemini-2.0-flash", "gemini-1.5-flash", "gemini-1.5-pro"
# OpenAI: "gpt-4o-mini", "gpt-4o"
LLM_MODEL=gemini-2.0-flash

# --- Provider API Keys ---
# For Gemini (either GEMINI_API_KEY or GOOGLE_API_KEY):
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# For OpenAI:
OPENAI_API_KEY=

# --- Pipeline Guardrails & Ceilings ---
MAX_STEPS=15
MAX_REWORK_COUNT=2
TOKEN_CEILING=50000
COST_CEILING_USD=2.00

# --- Directory Overrides (Optional) ---
# CASEFILE_DATA_DIR=data/claims
# CASEFILE_CHECKPOINT_DIR=.checkpoints
# CASEFILE_TRACES_DIR=traces

# --- LangSmith Tracing (Optional) ---
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=casefile
